{
  "name": "llmusage",
  "version": "0.5.1",
  "description": "macOS menu bar app for Claude Code usage tracking",
  "type": "module",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p src/main/tsconfig.json --watch & NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "build:preload": "tsc -p src/preload/tsconfig.json",
    "build:main": "tsc -p src/main/tsconfig.json",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "scan": "node dist/main/main/cli/scan.js",
    "scan:resume": "node dist/main/main/cli/scan.js --resume",
    "scan:json": "node dist/main/main/cli/scan.js --json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p src/main/tsconfig.typecheck.json"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "menubar": "^9.5.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.6",
    "concurrently": "^9.2.1",
    "electron": "^41.10.7",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.5"
  }
}
